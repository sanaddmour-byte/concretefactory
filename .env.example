# Quote + visit emails (Resend). Without these, production shows a "send on WhatsApp instead" fallback.
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@theconcretefactoryjo.com   # inbox that receives quote and visit requests
QUOTE_FROM_EMAIL=          # e.g. "The Concrete Factory <quotes@theconcretefactoryjo.com>" (domain must be verified in Resend)
# RESEND_API_URL=https://api.resend.com/emails   # override only for testing
