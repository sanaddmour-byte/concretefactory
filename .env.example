# Quote + visit emails (Resend). Without these, production shows a "send on WhatsApp instead" fallback.
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@theconcretefactoryjo.com   # inbox that receives quote and visit requests
QUOTE_FROM_EMAIL=          # e.g. "The Concrete Factory <quotes@theconcretefactoryjo.com>" (domain must be verified in Resend)
# RESEND_API_URL=https://api.resend.com/emails   # override only for testing

# Public site URL (canonical + hreflang). Set to the real domain at launch; localhost testing needs it to match the host.
NEXT_PUBLIC_SITE_URL=https://theconcretefactoryjo.com

# Optional: weekdays the business is closed for visits (0=Sunday..6=Saturday), e.g. "5,6" for Friday and Saturday; "none" = open every day.
# Until set (here or in content/site.json), visit dates are not checked against closures and the visit email says so.
VISIT_CLOSED_DAYS=
# Optional: per-IP request limit for the quote/visit forms (default 8 per 10 minutes)
RATE_LIMIT_MAX=
