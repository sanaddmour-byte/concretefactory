{
  "name": "concrete-factory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "predev": "node scripts/build-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-images.mjs",
    "build": "next build",
    "start": "next start",
    "images": "node scripts/build-images.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:preview": "playwright test -c playwright.preview.config.ts",
    "build:preview": "NEXT_PUBLIC_BASE_PATH=/concretefactory NEXT_PUBLIC_SITE_URL=https://example.github.io/concretefactory scripts/preview-build.sh",
    "build:og": "node scripts/build-og.mjs",
    "test:e2e": "playwright test",
    "build:e2e": "VISIT_CLOSED_DAYS=5,6 NEXT_PUBLIC_SITE_URL=http://localhost:3111 next build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.1",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "next-mdx-remote": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
